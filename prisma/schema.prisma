// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



model User {
  id          String   @id @default(uuid())
  email       String   @unique
  number      String   @unique
  ext         String
  name        String
  lastName    String
  dateOfBirth DateTime
  
  zipCode     String


  isActive    Boolean  @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userPasswords UserPassword[]
  userVerifications UserVerification[]
  userPasswordResets UserPasswordReset[]

}



model UserPassword {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  password  String
  salt      String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model UserPasswordReset {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String
  expiration DateTime
  used     Boolean  @default(false)
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
}


model UserVerification {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String
  expiration DateTime
  used     Boolean  @default(false)
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
}




model Quotation{
  id        String   @id @default(uuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  modelId   String
  model     Model    @relation(fields: [modelId], references: [id])
  descriptionId String
  description   Description @relation(fields: [descriptionId], references: [id])
  year      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id      String  @id @default(uuid())
  name    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models  Model[]  
  quotations Quotation[]
}

model Model {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branchId String   // FK al Branch
  branch   Branch   @relation(fields: [branchId], references: [id])


  descriptions Description[]
  quotations Quotation[]
}

model Description {
  id          String   @id @default(uuid())
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt


  modelId String   // FK al Model
  model Model @relation(fields: [modelId], references: [id])

  quotations Quotation[]
}
